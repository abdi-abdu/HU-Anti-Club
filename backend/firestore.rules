rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isActiveUser() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ── users ───────────────────────────────────────────────────────────────
    //
    // Security model:
    //   - Registration creates student accounts with status=pending only.
    //   - Owners can update a fixed set of personal fields; role and status excluded.
    //   - Admins may change status via exactly five approved source→destination pairs.
    //   - Admins may demote admin→student; source must currently be admin.
    //   - Admins may promote student→admin+active; source must currently be student.
    //   - Self-demotion and self-status-change are blocked at rule level.
    //   - The designated protected administrator's role, status, and document
    //     are immutable through any client SDK write. Use Firebase Console to
    //     modify the protected admin account if necessary.
    //
    match /users/{userId} {

      // Read: own profile, any admin, President, VP, or Secretary only
      // Supervisor is excluded — use memberProfiles collection for monitoring
      allow read: if isOwner(userId) || isAdmin()
        || (isSignedIn()
          && (
            (exists(/databases/$(database)/documents/positionIndex/president)
              && get(/databases/$(database)/documents/positionIndex/president).data.memberId == request.auth.uid)
            || (exists(/databases/$(database)/documents/positionIndex/vice_president)
              && get(/databases/$(database)/documents/positionIndex/vice_president).data.memberId == request.auth.uid)
            || (exists(/databases/$(database)/documents/positionIndex/secretary)
              && get(/databases/$(database)/documents/positionIndex/secretary).data.memberId == request.auth.uid)
          )
        );

      // Create: new registration only
      // Enforces role=student and status=pending — user cannot self-promote
      allow create: if isOwner(userId)
        && request.resource.data.role   == 'student'
        && request.resource.data.status == 'pending';

      // Update: owner changes their own personal profile fields only
      // Explicit allowlist — role, status, email, universityId, createdAt excluded
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['fullName', 'phone', 'department', 'yearOfStudy',
                       'college', 'privacy', 'photoUrl', 'updatedAt']);

      // Update: admin or active president changes status (all five transitions)
      // Exactly five approved source→destination pairs.
      // All other transitions — including same-status no-ops, pending destination,
      // and cross-assignments — are implicitly blocked by not appearing in any pair.
      // Self-status-change blocked (mirrors UI !isSelf guard at rule level).
      // Protected admin status cannot be changed by any client write.
      allow update: if (
          isAdmin()
          || (isSignedIn()
            && exists(/databases/$(database)/documents/positionIndex/president)
            && get(/databases/$(database)/documents/positionIndex/president).data.memberId == request.auth.uid)
        )
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['status', 'updatedAt'])
        && userId != request.auth.uid
        && userId != '3HL1cghtVvScyiHSLPDGdkIdaMF3'
        && (
             (resource.data.status == 'pending'     && request.resource.data.status == 'active'     )  // approve
          || (resource.data.status == 'pending'     && request.resource.data.status == 'rejected'   )  // reject
          || (resource.data.status == 'active'      && request.resource.data.status == 'deactivated')  // deactivate
          || (resource.data.status == 'deactivated' && request.resource.data.status == 'active'     )  // reactivate
          || (resource.data.status == 'rejected'    && request.resource.data.status == 'active'     )  // reactivate
           );

      // Update: active vice president changes status (limited transitions only)
      // VP can approve, reject, and reactivate from rejected status only.
      // VP CANNOT deactivate active members or reactivate deactivated members.
      // Self-status-change blocked. Protected admin status cannot be changed.
      allow update: if isSignedIn()
        && exists(/databases/$(database)/documents/positionIndex/vice_president)
        && get(/databases/$(database)/documents/positionIndex/vice_president).data.memberId == request.auth.uid
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['status', 'updatedAt'])
        && userId != request.auth.uid
        && userId != '3HL1cghtVvScyiHSLPDGdkIdaMF3'
        && (
             (resource.data.status == 'pending'  && request.resource.data.status == 'active'   )  // approve
          || (resource.data.status == 'pending'  && request.resource.data.status == 'rejected')  // reject
          || (resource.data.status == 'rejected' && request.resource.data.status == 'active'   )  // reactivate from rejected
           );

      // Update: admin removes admin role
      // Source must currently be admin. Destination must be student.
      // Self-demotion blocked. Protected admin cannot be demoted.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['role', 'updatedAt'])
        && resource.data.role         == 'admin'
        && request.resource.data.role == 'student'
        && userId != request.auth.uid
        && userId != '3HL1cghtVvScyiHSLPDGdkIdaMF3';

      // Update: admin promotes a member to admin
      // Source must currently be student. Destination must be exactly role=admin
      // and status=active together — no other role+status combination permitted.
      // Self-promotion blocked. Protected admin excluded.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['role', 'status', 'updatedAt'])
        && resource.data.role           == 'student'
        && request.resource.data.role   == 'admin'
        && request.resource.data.status == 'active'
        && userId != request.auth.uid
        && userId != '3HL1cghtVvScyiHSLPDGdkIdaMF3';

      // Update: admin edits a member's profile fields
      // Explicit allowlist matching exactly what Members.jsx saveEdit sends.
      // role, status, email, universityId, createdAt, privacy excluded.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['fullName', 'phone', 'department', 'yearOfStudy',
                       'college', 'updatedAt']);

      // Update: authorized officers (President, VP) edit member profile fields
      // Same field allowlist as admin edit rule above.
      // Supervisor and Secretary are explicitly excluded from this rule.
      // role, status, email, universityId, createdAt, privacy excluded.
      allow update: if (isSignedIn()
          && (
            (exists(/databases/$(database)/documents/positionIndex/president)
              && get(/databases/$(database)/documents/positionIndex/president).data.memberId == request.auth.uid)
            || (exists(/databases/$(database)/documents/positionIndex/vice_president)
              && get(/databases/$(database)/documents/positionIndex/vice_president).data.memberId == request.auth.uid)
          )
        )
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['fullName', 'phone', 'department', 'yearOfStudy',
                       'college', 'updatedAt']);

      // Delete: admin only
      // Protected admin document cannot be deleted by any client write.
      // To modify the protected admin account use Firebase Console directly.
      allow delete: if isAdmin()
        && userId != '3HL1cghtVvScyiHSLPDGdkIdaMF3';
    }

    // ── memberProfiles ──────────────────────────────────────────────────────
    //
    // Non-private member monitoring collection for Supervisor access.
    // Contains only public member information (no email, no phone).
    // Synced from users collection via batch writes in registration/update flows.
    //
    // Security model:
    //   - Read: own profile, any admin, or any active club officer (including Supervisor)
    //   - Write: Read-only for officers — populated via batch writes from backend operations
    //   - Officers cannot directly write to this collection (prevents data manipulation)
    //
    match /memberProfiles/{userId} {

      // Document read: own profile, any admin, or any active club officer (including Supervisor)
      allow get: if isOwner(userId) || isAdmin()
        || (isSignedIn()
          && (
            (exists(/databases/$(database)/documents/positionIndex/supervisor)
              && get(/databases/$(database)/documents/positionIndex/supervisor).data.memberId == request.auth.uid)
            || (exists(/databases/$(database)/documents/positionIndex/president)
              && get(/databases/$(database)/documents/positionIndex/president).data.memberId == request.auth.uid)
            || (exists(/databases/$(database)/documents/positionIndex/vice_president)
              && get(/databases/$(database)/documents/positionIndex/vice_president).data.memberId == request.auth.uid)
            || (exists(/databases/$(database)/documents/positionIndex/secretary)
              && get(/databases/$(database)/documents/positionIndex/secretary).data.memberId == request.auth.uid)
          )
        );

      // Collection query: admin or any active club officer (including Supervisor)
      // Officers need collection-level access for member listing in Leadership and Members pages
      allow list: if isAdmin()
        || (isSignedIn()
          && (
            (exists(/databases/$(database)/documents/positionIndex/supervisor)
              && get(/databases/$(database)/documents/positionIndex/supervisor).data.memberId == request.auth.uid)
            || (exists(/databases/$(database)/documents/positionIndex/president)
              && get(/databases/$(database)/documents/positionIndex/president).data.memberId == request.auth.uid)
            || (exists(/databases/$(database)/documents/positionIndex/vice_president)
              && get(/databases/$(database)/documents/positionIndex/vice_president).data.memberId == request.auth.uid)
            || (exists(/databases/$(database)/documents/positionIndex/secretary)
              && get(/databases/$(database)/documents/positionIndex/secretary).data.memberId == request.auth.uid)
          )
        );

      // Create: during registration OR lazy migration from profile updates
      // Two scenarios:
      //   1. Registration: owner creates with role=student, status=pending
      //   2. Lazy migration: owner/admin/officer creates via set(..., {merge:true})
      // Blocks email, phone, privacy in all cases
      allow create: if !request.resource.data.keys().hasAny(['email', 'phone', 'privacy'])
        && (
          // Scenario 1: Registration (owner creates with full fields)
          (isOwner(userId)
            && request.resource.data.role   == 'student'
            && request.resource.data.status == 'pending')
          // Scenario 2: Lazy migration (owner, admin, or authorized officer)
          || (
            (isOwner(userId) || isAdmin()
              || (isSignedIn()
                && (
                  (exists(/databases/$(database)/documents/positionIndex/president)
                    && get(/databases/$(database)/documents/positionIndex/president).data.memberId == request.auth.uid)
                  || (exists(/databases/$(database)/documents/positionIndex/vice_president)
                    && get(/databases/$(database)/documents/positionIndex/vice_president).data.memberId == request.auth.uid)
                )
              )
            )
            // Lazy migration: allows subset of fields (doesn't require role/status)
            && request.resource.data.keys().hasOnly(['fullName', 'department', 'yearOfStudy',
                                                      'college', 'status', 'role', 'universityId',
                                                      'updatedAt', 'createdAt', 'createdBy'])
          )
        );

      // Update: owner can edit permitted personal profile fields only.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['fullName', 'department', 'yearOfStudy', 'college',
                       'updatedAt']);

      // Update: admin retains authorized profile synchronization.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['fullName', 'department', 'yearOfStudy', 'college',
                       'status', 'role', 'universityId', 'updatedAt',
                       'createdAt', 'createdBy']);

      // Update: President and VP can edit ordinary profile fields.
      // Role/status changes must match a users update in the same batch.
      // universityId remains protected.
      allow update: if isSignedIn()
        && (
          (exists(/databases/$(database)/documents/positionIndex/president)
            && get(/databases/$(database)/documents/positionIndex/president).data.memberId == request.auth.uid)
          || (exists(/databases/$(database)/documents/positionIndex/vice_president)
            && get(/databases/$(database)/documents/positionIndex/vice_president).data.memberId == request.auth.uid)
        )
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['fullName', 'department', 'yearOfStudy', 'college',
                       'status', 'role', 'updatedAt'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || (
            getAfter(/databases/$(database)/documents/users/$(userId)).data.status
              == request.resource.data.status
            && getAfter(/databases/$(database)/documents/users/$(userId)).data.diff(
                 get(/databases/$(database)/documents/users/$(userId)).data
               ).affectedKeys().hasAny(['status'])
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
          || (
            getAfter(/databases/$(database)/documents/users/$(userId)).data.role
              == request.resource.data.role
            && getAfter(/databases/$(database)/documents/users/$(userId)).data.diff(
                 get(/databases/$(database)/documents/users/$(userId)).data
               ).affectedKeys().hasAny(['role'])
          )
        );

      // Delete: admin only (should mirror users collection deletion)
      allow delete: if isAdmin()
        && userId != '3HL1cghtVvScyiHSLPDGdkIdaMF3';
    }

    // ── announcements ────────────────────────────────────────────────────────
    // Spec §4–7: Admin, President, VP, Secretary can create/edit/publish/unpublish.
    // Spec §4: Admin and President can delete.
    match /announcements/{announcementId} {
      allow read: if true;

      // Create: Admin, President, VP, Secretary
      allow create: if (
          isAdmin()
          || (isSignedIn()
            && (
              (exists(/databases/$(database)/documents/positionIndex/president)
                && get(/databases/$(database)/documents/positionIndex/president).data.memberId == request.auth.uid)
              || (exists(/databases/$(database)/documents/positionIndex/vice_president)
                && get(/databases/$(database)/documents/positionIndex/vice_president).data.memberId == request.auth.uid)
              || (exists(/databases/$(database)/documents/positionIndex/secretary)
                && get(/databases/$(database)/documents/positionIndex/secretary).data.memberId == request.auth.uid)
            )
          )
        )
        && request.resource.data.keys().hasAll([
             'title', 'message', 'published', 'createdBy', 'createdAt'
           ]);

      // Update: Admin has unrestricted access
      allow update: if isAdmin();

      // Update: President, VP, Secretary — editable fields only (protects createdBy, createdAt)
      allow update: if isSignedIn()
        && (
          (exists(/databases/$(database)/documents/positionIndex/president)
            && get(/databases/$(database)/documents/positionIndex/president).data.memberId == request.auth.uid)
          || (exists(/databases/$(database)/documents/positionIndex/vice_president)
            && get(/databases/$(database)/documents/positionIndex/vice_president).data.memberId == request.auth.uid)
          || (exists(/databases/$(database)/documents/positionIndex/secretary)
            && get(/databases/$(database)/documents/positionIndex/secretary).data.memberId == request.auth.uid)
        )
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['title', 'message', 'type', 'published', 'publishedAt', 'updatedAt']);

      // Delete: Admin and President only
      allow delete: if isAdmin()
        || (isSignedIn()
          && exists(/databases/$(database)/documents/positionIndex/president)
          && get(/databases/$(database)/documents/positionIndex/president).data.memberId == request.auth.uid
        );
    }

    // ── leadership ───────────────────────────────────────────────────────────
    // Public read. Only admins can create or update.
    // No delete — historical records must be preserved.
    match /leadership/{appointmentId} {
      allow read: if true;

      // Admins can create any appointment.
      // Active Supervisor can create appointments for president, vice_president, secretary
      // but NOT for the supervisor position (cannot manage own appointment).
      allow create: if (
          isAdmin()
          || (
            isSignedIn()
            && exists(/databases/$(database)/documents/positionIndex/supervisor)
            && get(/databases/$(database)/documents/positionIndex/supervisor).data.memberId == request.auth.uid
            && request.resource.data.position != 'supervisor'
          )
        )
        && request.resource.data.keys().hasAll([
             'memberId', 'position', 'startDate', 'status', 'createdBy', 'createdAt'
           ]);

      // Admins can update appointment metadata and end terms, but cannot
      // rewrite historical identity (memberId, position, or startDate).
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['endDate', 'status', 'notes', 'photoUrl', 'showPublicly',
                       'updatedAt', 'updatedBy'])
        // Ending an active appointment must remove its matching index atomically.
        && (
          resource.data.status != 'active'
          || request.resource.data.status != 'ended'
          || (
            exists(/databases/$(database)/documents/positionIndex/$(resource.data.position))
            && get(/databases/$(database)/documents/positionIndex/$(resource.data.position)).data.appointmentId == appointmentId
            && get(/databases/$(database)/documents/positionIndex/$(resource.data.position)).data.memberId == resource.data.memberId
            && !existsAfter(/databases/$(database)/documents/positionIndex/$(resource.data.position))
          )
        );

      // Active Supervisor can update president, vice_president, secretary appointments
      // but NOT the supervisor appointment. Restricted to editable fields only.
      allow update: if isSignedIn()
        && exists(/databases/$(database)/documents/positionIndex/supervisor)
        && get(/databases/$(database)/documents/positionIndex/supervisor).data.memberId == request.auth.uid
        && resource.data.position != 'supervisor'
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['endDate', 'status', 'notes', 'photoUrl', 'showPublicly',
                       'updatedAt', 'updatedBy'])
        // Ending an active appointment must remove its matching index atomically.
        && (
          resource.data.status != 'active'
          || request.resource.data.status != 'ended'
          || (
            exists(/databases/$(database)/documents/positionIndex/$(resource.data.position))
            && get(/databases/$(database)/documents/positionIndex/$(resource.data.position)).data.appointmentId == appointmentId
            && get(/databases/$(database)/documents/positionIndex/$(resource.data.position)).data.memberId == resource.data.memberId
            && !existsAfter(/databases/$(database)/documents/positionIndex/$(resource.data.position))
          )
        );
    }

    // ── positionIndex ─────────────────────────────────────────────────────────
    // Fixed documents: supervisor, president, vice_president, secretary, acting_president
    // Acts as a live lookup index: maps position → current active memberId.
    // Written atomically alongside leadership documents using writeBatch.
    //
    // Security model:
    //   - Any signed-in user can read (needed to resolve own position in the UI).
    //   - Admins can write any positionIndex entry.
    //   - Active Supervisor can write president, vice_president, secretary entries
    //     but NOT the supervisor entry (cannot manage own index).
    //   - Every write is cross-validated against the leadership document being
    //     written in the same batch, using getAfter().
    //   - No delete without a corresponding leadership update in the same batch
    //     (enforced by requiring the index entry to match an active appointment
    //     or by the batch failing atomically if the leadership write fails).
    match /positionIndex/{positionId} {
      allow read: if isSignedIn();

      // Write (create/update) for supervisor position: admin only
      allow write: if positionId == 'supervisor'
        && isAdmin()
        && request.resource.data.keys().hasAll(['memberId', 'appointmentId', 'updatedAt'])
        && getAfter(/databases/$(database)/documents/leadership/$(request.resource.data.appointmentId)).data.position == 'supervisor'
        && getAfter(/databases/$(database)/documents/leadership/$(request.resource.data.appointmentId)).data.memberId == request.resource.data.memberId
        && getAfter(/databases/$(database)/documents/leadership/$(request.resource.data.appointmentId)).data.status == 'active';

      // Write (create/update) for president, vice_president, secretary: admin or active supervisor
      allow write: if positionId in ['president', 'vice_president', 'secretary']
        && (
          isAdmin()
          || (
            isSignedIn()
            && exists(/databases/$(database)/documents/positionIndex/supervisor)
            && get(/databases/$(database)/documents/positionIndex/supervisor).data.memberId == request.auth.uid
          )
        )
        && request.resource.data.keys().hasAll(['memberId', 'appointmentId', 'updatedAt'])
        && getAfter(/databases/$(database)/documents/leadership/$(request.resource.data.appointmentId)).data.position == positionId
        && getAfter(/databases/$(database)/documents/leadership/$(request.resource.data.appointmentId)).data.memberId == request.resource.data.memberId
        && getAfter(/databases/$(database)/documents/leadership/$(request.resource.data.appointmentId)).data.status == 'active';

      // Delete (end appointment): admin can delete any; supervisor can delete president/vp/secretary.
      // Requires that the index references a valid active appointment. This prevents:
      //   - Deletion of non-existent/stale index entries
      //   - Multiple deletions of the same index
      // The matching appointment must be marked ended in the same atomic batch.
      // getAfter() verifies its future state and identity.
      allow delete: if (
          isAdmin()
          || (
            positionId in ['president', 'vice_president', 'secretary']
            && isSignedIn()
            && exists(/databases/$(database)/documents/positionIndex/supervisor)
            && get(/databases/$(database)/documents/positionIndex/supervisor).data.memberId == request.auth.uid
          )
        )
        && exists(/databases/$(database)/documents/positionIndex/$(positionId))
        && resource.data.keys().hasAll(['memberId', 'appointmentId'])
        && exists(/databases/$(database)/documents/leadership/$(resource.data.appointmentId))
        && get(/databases/$(database)/documents/leadership/$(resource.data.appointmentId)).data.status == 'active'
        // The same atomic batch must end the exact appointment referenced by this index.
        && existsAfter(/databases/$(database)/documents/leadership/$(resource.data.appointmentId))
        && getAfter(/databases/$(database)/documents/leadership/$(resource.data.appointmentId)).data.status == 'ended'
        && getAfter(/databases/$(database)/documents/leadership/$(resource.data.appointmentId)).data.position == positionId
        && getAfter(/databases/$(database)/documents/leadership/$(resource.data.appointmentId)).data.memberId == resource.data.memberId;
    }

    // ── events ──────────────────────────────────────────────────────────────
    // Spec §4–7: Admin, President, VP, Secretary can create/edit/publish/unpublish/cancel.
    // Spec §4: Admin and President can permanently delete.
    match /events/{eventId} {
      allow read: if true;

      // Create: Admin, President, VP, Secretary
      allow create: if (
          isAdmin()
          || (isSignedIn()
            && (
              (exists(/databases/$(database)/documents/positionIndex/president)
                && get(/databases/$(database)/documents/positionIndex/president).data.memberId == request.auth.uid)
              || (exists(/databases/$(database)/documents/positionIndex/vice_president)
                && get(/databases/$(database)/documents/positionIndex/vice_president).data.memberId == request.auth.uid)
              || (exists(/databases/$(database)/documents/positionIndex/secretary)
                && get(/databases/$(database)/documents/positionIndex/secretary).data.memberId == request.auth.uid)
            )
          )
        )
        && request.resource.data.keys().hasAll([
             'title', 'description', 'date', 'location', 'createdBy', 'createdAt'
           ])
        && request.resource.data.createdBy == request.auth.uid;

      // Update: Admin has unrestricted access
      allow update: if isAdmin();

      // Update: President — editable fields including all status values (draft, published, cancelled)
      // President can publish, unpublish, cancel, and restore events.
      allow update: if isSignedIn()
        && exists(/databases/$(database)/documents/positionIndex/president)
        && get(/databases/$(database)/documents/positionIndex/president).data.memberId == request.auth.uid
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['title', 'description', 'date', 'location', 'type', 'imageUrl',
                       'status', 'updatedAt', 'updatedBy']);

      // Update: VP and Secretary — editable fields with restricted status values
      // Can publish/unpublish (draft ↔ published) but CANNOT cancel or restore.
      // Validates both source and destination status to prevent modifying cancelled events.
      // Cancelled events are completely read-only for VP and Secretary.
      allow update: if isSignedIn()
        && (
          (exists(/databases/$(database)/documents/positionIndex/vice_president)
            && get(/databases/$(database)/documents/positionIndex/vice_president).data.memberId == request.auth.uid)
          || (exists(/databases/$(database)/documents/positionIndex/secretary)
            && get(/databases/$(database)/documents/positionIndex/secretary).data.memberId == request.auth.uid)
        )
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['title', 'description', 'date', 'location', 'type', 'imageUrl', 
                       'status', 'updatedAt', 'updatedBy'])
        && (
          // Block all updates to cancelled events (source status must be draft or published)
          resource.data.status == 'draft' || resource.data.status == 'published'
        )
        && (
          // If status is being changed, destination must also be draft or published
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || (request.resource.data.status == 'draft' || request.resource.data.status == 'published')
        );

      // Delete: Admin and President only
      allow delete: if isAdmin()
        || (isSignedIn()
          && exists(/databases/$(database)/documents/positionIndex/president)
          && get(/databases/$(database)/documents/positionIndex/president).data.memberId == request.auth.uid
        );

      // Registrations subcollection.
      // Active members register/unregister themselves only.
      // Admins and officers read all registrations.
      match /registrations/{userId} {
        allow read: if isAdmin()
          || (isSignedIn()
            && (
              (exists(/databases/$(database)/documents/positionIndex/supervisor)
                && get(/databases/$(database)/documents/positionIndex/supervisor).data.memberId == request.auth.uid)
              || (exists(/databases/$(database)/documents/positionIndex/president)
                && get(/databases/$(database)/documents/positionIndex/president).data.memberId == request.auth.uid)
              || (exists(/databases/$(database)/documents/positionIndex/vice_president)
                && get(/databases/$(database)/documents/positionIndex/vice_president).data.memberId == request.auth.uid)
              || (exists(/databases/$(database)/documents/positionIndex/secretary)
                && get(/databases/$(database)/documents/positionIndex/secretary).data.memberId == request.auth.uid)
            )
          );
        allow create: if isActiveUser() && request.auth.uid == userId;
        allow delete: if isActiveUser() && request.auth.uid == userId;
      }
    }

    // ── posts ───────────────────────────────────────────────────────────────
    // Spec §4–7: Admin, President, VP can create/edit/publish/delete.
    // Spec §7: Secretary can create/edit (approval workflow deferred).
    // For now: Secretary has same permissions as President/VP (no approval check).
    match /posts/{postId} {
      allow read: if true;

      // Create: Admin, President, VP, Secretary
      allow create: if (
          isAdmin()
          || (isSignedIn()
            && (
              (exists(/databases/$(database)/documents/positionIndex/president)
                && get(/databases/$(database)/documents/positionIndex/president).data.memberId == request.auth.uid)
              || (exists(/databases/$(database)/documents/positionIndex/vice_president)
                && get(/databases/$(database)/documents/positionIndex/vice_president).data.memberId == request.auth.uid)
              || (exists(/databases/$(database)/documents/positionIndex/secretary)
                && get(/databases/$(database)/documents/positionIndex/secretary).data.memberId == request.auth.uid)
            )
          )
        )
        && request.resource.data.keys().hasAll([
             'title', 'content', 'category', 'authorId', 'createdAt'
           ])
        && request.resource.data.authorId == request.auth.uid;

      // Update: Admin has unrestricted access
      allow update: if isAdmin();

      // Update: President, VP, Secretary — editable fields only (protects authorId, createdAt)
      allow update: if isSignedIn()
        && (
          (exists(/databases/$(database)/documents/positionIndex/president)
            && get(/databases/$(database)/documents/positionIndex/president).data.memberId == request.auth.uid)
          || (exists(/databases/$(database)/documents/positionIndex/vice_president)
            && get(/databases/$(database)/documents/positionIndex/vice_president).data.memberId == request.auth.uid)
          || (exists(/databases/$(database)/documents/positionIndex/secretary)
            && get(/databases/$(database)/documents/positionIndex/secretary).data.memberId == request.auth.uid)
        )
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['title', 'content', 'category', 'excerpt', 'imageUrl', 
                       'published', 'featured', 'updatedAt', 'updatedBy']);

      // Delete: Admin and President only (spec §4, §5 no delete for VP, §7 no delete for Secretary)
      allow delete: if isAdmin()
        || (isSignedIn()
          && exists(/databases/$(database)/documents/positionIndex/president)
          && get(/databases/$(database)/documents/positionIndex/president).data.memberId == request.auth.uid
        );
    }

    // ── resources ───────────────────────────────────────────────────────────
    match /resources/{resourceId} {
      allow read: if isActiveUser() || isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
             'title', 'description', 'uploadedBy', 'createdAt'
           ])
        && request.resource.data.uploadedBy == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    // ── anonymousMessages ────────────────────────────────────────────────────
    match /anonymousMessages/{messageId} {
      // Admins and president/VP/secretary can read individual messages.
      // Supervisors cannot read individual messages (spec §3).
      allow read: if isAdmin()
        || (isSignedIn()
          && (
            (exists(/databases/$(database)/documents/positionIndex/president)
              && get(/databases/$(database)/documents/positionIndex/president).data.memberId == request.auth.uid)
            || (exists(/databases/$(database)/documents/positionIndex/vice_president)
              && get(/databases/$(database)/documents/positionIndex/vice_president).data.memberId == request.auth.uid)
            || (exists(/databases/$(database)/documents/positionIndex/secretary)
              && get(/databases/$(database)/documents/positionIndex/secretary).data.memberId == request.auth.uid)
          )
        );

      // Anyone (including unauthenticated) can submit an anonymous message.
      allow create: if request.resource.data.keys().hasAll([
                         'subject', 'message', 'createdAt', 'isReplied'
                       ])
                    && request.resource.data.isReplied == false;

      // Admins and president/VP/secretary can mark as replied.
      allow update: if (isAdmin()
          || (isSignedIn()
            && (
              (exists(/databases/$(database)/documents/positionIndex/president)
                && get(/databases/$(database)/documents/positionIndex/president).data.memberId == request.auth.uid)
              || (exists(/databases/$(database)/documents/positionIndex/vice_president)
                && get(/databases/$(database)/documents/positionIndex/vice_president).data.memberId == request.auth.uid)
              || (exists(/databases/$(database)/documents/positionIndex/secretary)
                && get(/databases/$(database)/documents/positionIndex/secretary).data.memberId == request.auth.uid)
            )
          ))
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['isReplied']);
    }

    // ── activityLogs ─────────────────────────────────────────────────────────
    // Append-only from authenticated users (each user logs their own actions).
    // Admins and active club officers can read logs (spec §3–7).
    // Nobody can update or delete logs — immutable audit trail.
    match /activityLogs/{logId} {
      // Admins always have access
      allow read: if isAdmin();
      // Club officers: check positionIndex — anyone listed in any position slot can read
      allow read: if isSignedIn()
        && (
          (exists(/databases/$(database)/documents/positionIndex/supervisor)
            && get(/databases/$(database)/documents/positionIndex/supervisor).data.memberId == request.auth.uid)
          || (exists(/databases/$(database)/documents/positionIndex/president)
            && get(/databases/$(database)/documents/positionIndex/president).data.memberId == request.auth.uid)
          || (exists(/databases/$(database)/documents/positionIndex/vice_president)
            && get(/databases/$(database)/documents/positionIndex/vice_president).data.memberId == request.auth.uid)
          || (exists(/databases/$(database)/documents/positionIndex/secretary)
            && get(/databases/$(database)/documents/positionIndex/secretary).data.memberId == request.auth.uid)
        );
      allow create: if isSignedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.keys().hasAll([
             'actorId', 'action', 'recordType', 'recordId', 'timestamp'
           ]);
      allow update: if false;
      allow delete: if false;
    }

    // ── stats ────────────────────────────────────────────────────────────────
    // Homepage statistics aggregate document (public read, admin-only write).
    // Contains only aggregate counts for public display, no private data.
    match /stats/current {
      // Anyone (including unauthenticated) can read aggregate stats for homepage
      allow read: if true;

      // Only admins can create or update stats
      allow write: if isAdmin();
    }
  }
}
