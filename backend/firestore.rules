rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isActiveUser() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ── users ───────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Anyone can read their own profile; admins can read all profiles.
      allow read: if isOwner(userId) || isAdmin();

      // New registration: user creates their own document.
      // Enforces role=student and status=pending — cannot self-promote.
      allow create: if isOwner(userId)
        && request.resource.data.role == 'student'
        && request.resource.data.status == 'pending';

      // Profile self-update: owner can only change safe personal fields.
      // Role and status are NOT in this list — only admins can change those.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['fullName', 'phone', 'department', 'yearOfStudy',
                       'college', 'privacy', 'updatedAt']);

      // Admins can update anything on any user document (approvals, role changes).
      allow update: if isAdmin();

      // Only admins can delete user documents (rare, but allowed for cleanup).
      allow delete: if isAdmin();
    }

    // ── announcements ────────────────────────────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
             'title', 'message', 'published', 'createdBy', 'createdAt'
           ]);
      allow update, delete: if isAdmin();
    }

    // ── leadership ───────────────────────────────────────────────────────────
    // Public read. Only admins can create or update.
    // No delete — historical records must be preserved.
    match /leadership/{appointmentId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
             'memberId', 'position', 'startDate', 'status', 'createdBy', 'createdAt'
           ]);
      allow update: if isAdmin();
    }

    // ── events ──────────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read: if true;

      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
             'title', 'description', 'date', 'location', 'createdBy', 'createdAt'
           ])
        && request.resource.data.createdBy == request.auth.uid;

      allow update, delete: if isAdmin();

      // Registrations subcollection.
      // Active members register/unregister themselves only.
      // Admins read all registrations.
      match /registrations/{userId} {
        allow read: if isAdmin();
        allow create: if isActiveUser() && request.auth.uid == userId;
        allow delete: if isActiveUser() && request.auth.uid == userId;
      }
    }

    // ── posts ───────────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if true;

      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
             'title', 'content', 'category', 'authorId', 'createdAt'
           ])
        && request.resource.data.authorId == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    // ── resources ───────────────────────────────────────────────────────────
    match /resources/{resourceId} {
      allow read: if isActiveUser() || isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
             'title', 'description', 'uploadedBy', 'createdAt'
           ])
        && request.resource.data.uploadedBy == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    // ── anonymousMessages ────────────────────────────────────────────────────
    match /anonymousMessages/{messageId} {
      allow read: if isAdmin();

      // Anyone (including unauthenticated) can submit an anonymous message.
      allow create: if request.resource.data.keys().hasAll([
                         'subject', 'message', 'createdAt', 'isReplied'
                       ])
                    && request.resource.data.isReplied == false;

      // Admins can only flip the isReplied flag — no other field changes.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['isReplied']);
    }

    // ── activityLogs ─────────────────────────────────────────────────────────
    // Append-only from authenticated users (each user logs their own actions).
    // Only admins can read logs.
    // Nobody can update or delete logs — immutable audit trail.
    match /activityLogs/{logId} {
      allow read:   if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.keys().hasAll([
             'actorId', 'action', 'recordType', 'recordId', 'timestamp'
           ]);
      allow update: if false;
      allow delete: if false;
    }
  }
}
