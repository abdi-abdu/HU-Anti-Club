rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isActiveUser() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ── users ───────────────────────────────────────────────────────────────
    //
    // Security model:
    //   - Registration creates student accounts with status=pending only.
    //   - Owners can update a fixed set of personal fields; role and status excluded.
    //   - Admins may change status via exactly five approved source→destination pairs.
    //   - Admins may demote admin→student; source must currently be admin.
    //   - Admins may promote student→admin+active; source must currently be student.
    //   - Self-demotion and self-status-change are blocked at rule level.
    //   - The designated protected administrator's role, status, and document
    //     are immutable through any client SDK write. Use Firebase Console to
    //     modify the protected admin account if necessary.
    //
    match /users/{userId} {

      // Read: own profile or any admin
      allow read: if isOwner(userId) || isAdmin();

      // Create: new registration only
      // Enforces role=student and status=pending — user cannot self-promote
      allow create: if isOwner(userId)
        && request.resource.data.role   == 'student'
        && request.resource.data.status == 'pending';

      // Update: owner changes their own personal profile fields only
      // Explicit allowlist — role, status, email, universityId, createdAt excluded
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['fullName', 'phone', 'department', 'yearOfStudy',
                       'college', 'privacy', 'updatedAt']);

      // Update: admin changes status only
      // Exactly five approved source→destination pairs.
      // All other transitions — including same-status no-ops, pending destination,
      // and cross-assignments — are implicitly blocked by not appearing in any pair.
      // Self-status-change blocked (mirrors UI !isSelf guard at rule level).
      // Protected admin status cannot be changed by any client write.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['status', 'updatedAt'])
        && userId != request.auth.uid
        && userId != '3HL1cghtVvScyiHSLPDGdkIdaMF3'
        && (
             (resource.data.status == 'pending'     && request.resource.data.status == 'active'     )  // approve
          || (resource.data.status == 'pending'     && request.resource.data.status == 'rejected'   )  // reject
          || (resource.data.status == 'active'      && request.resource.data.status == 'deactivated')  // deactivate
          || (resource.data.status == 'deactivated' && request.resource.data.status == 'active'     )  // reactivate
          || (resource.data.status == 'rejected'    && request.resource.data.status == 'active'     )  // reactivate
           );

      // Update: admin removes admin role
      // Source must currently be admin. Destination must be student.
      // Self-demotion blocked. Protected admin cannot be demoted.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['role', 'updatedAt'])
        && resource.data.role         == 'admin'
        && request.resource.data.role == 'student'
        && userId != request.auth.uid
        && userId != '3HL1cghtVvScyiHSLPDGdkIdaMF3';

      // Update: admin promotes a member to admin
      // Source must currently be student. Destination must be exactly role=admin
      // and status=active together — no other role+status combination permitted.
      // Self-promotion blocked. Protected admin excluded.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['role', 'status', 'updatedAt'])
        && resource.data.role           == 'student'
        && request.resource.data.role   == 'admin'
        && request.resource.data.status == 'active'
        && userId != request.auth.uid
        && userId != '3HL1cghtVvScyiHSLPDGdkIdaMF3';

      // Update: admin edits a member's profile fields
      // Explicit allowlist matching exactly what Members.jsx saveEdit sends.
      // role, status, email, universityId, createdAt, privacy excluded.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['fullName', 'phone', 'department', 'yearOfStudy',
                       'college', 'updatedAt']);

      // Delete: admin only
      // Protected admin document cannot be deleted by any client write.
      // To modify the protected admin account use Firebase Console directly.
      allow delete: if isAdmin()
        && userId != '3HL1cghtVvScyiHSLPDGdkIdaMF3';
    }

    // ── announcements ────────────────────────────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
             'title', 'message', 'published', 'createdBy', 'createdAt'
           ]);
      allow update, delete: if isAdmin();
    }

    // ── leadership ───────────────────────────────────────────────────────────
    // Public read. Only admins can create or update.
    // No delete — historical records must be preserved.
    match /leadership/{appointmentId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
             'memberId', 'position', 'startDate', 'status', 'createdBy', 'createdAt'
           ]);
      allow update: if isAdmin();
    }

    // ── events ──────────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read: if true;

      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
             'title', 'description', 'date', 'location', 'createdBy', 'createdAt'
           ])
        && request.resource.data.createdBy == request.auth.uid;

      allow update, delete: if isAdmin();

      // Registrations subcollection.
      // Active members register/unregister themselves only.
      // Admins read all registrations.
      match /registrations/{userId} {
        allow read: if isAdmin();
        allow create: if isActiveUser() && request.auth.uid == userId;
        allow delete: if isActiveUser() && request.auth.uid == userId;
      }
    }

    // ── posts ───────────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if true;

      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
             'title', 'content', 'category', 'authorId', 'createdAt'
           ])
        && request.resource.data.authorId == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    // ── resources ───────────────────────────────────────────────────────────
    match /resources/{resourceId} {
      allow read: if isActiveUser() || isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
             'title', 'description', 'uploadedBy', 'createdAt'
           ])
        && request.resource.data.uploadedBy == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    // ── anonymousMessages ────────────────────────────────────────────────────
    match /anonymousMessages/{messageId} {
      allow read: if isAdmin();

      // Anyone (including unauthenticated) can submit an anonymous message.
      allow create: if request.resource.data.keys().hasAll([
                         'subject', 'message', 'createdAt', 'isReplied'
                       ])
                    && request.resource.data.isReplied == false;

      // Admins can only flip the isReplied flag — no other field changes.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['isReplied']);
    }

    // ── activityLogs ─────────────────────────────────────────────────────────
    // Append-only from authenticated users (each user logs their own actions).
    // Only admins can read logs.
    // Nobody can update or delete logs — immutable audit trail.
    match /activityLogs/{logId} {
      allow read:   if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.keys().hasAll([
             'actorId', 'action', 'recordType', 'recordId', 'timestamp'
           ]);
      allow update: if false;
      allow delete: if false;
    }
  }
}
