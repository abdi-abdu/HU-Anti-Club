rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Helper functions ──────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isImageFile() {
      return request.resource.contentType.matches('image/.*');
    }

    function isReasonableSize() {
      // max 5 MB
      return request.resource.size < 5 * 1024 * 1024;
    }

    // ── Event / post images — admin upload, public read ───────────────────
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImageFile() && isReasonableSize();
    }

    // ── Resources (PDFs, docs) — admin upload, active member read ─────────
    match /resources/{allPaths=**} {
      allow read: if request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active';
      allow write: if isAdmin() && isReasonableSize();
    }

    // ── Profile pictures ──────────────────────────────────────────────────
    // Users can upload their own profile picture.
    // Admins can upload leadership photos for any member (for About page).
    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if (isOwner(userId) || isAdmin()) && isImageFile() && isReasonableSize();
    }
  }
}
